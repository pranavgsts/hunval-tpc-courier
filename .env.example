# Copy to .env and fill in. Never commit .env.

PORT=3000
# mysql://USER:PASSWORD@HOST:3306/DATABASE (URL-encode special characters in the password)
DATABASE_URL=mysql://root@localhost:3306/tpc_courier

# --- Shopify (Dev Dashboard app installed on the client's store) ---
# Store subdomain only, without .myshopify.com
SHOPIFY_SHOP=your-store
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10
# Optional: a static Admin API token. When set, the client-credentials grant is skipped.
SHOPIFY_ACCESS_TOKEN=

# --- TPC ---
# dry-run: build and log the booking, never call TPC, never use a consignment number
# live:    call TPC_API_URL (point it at the mock server during development)
TPC_MODE=dry-run
TPC_API_URL=http://localhost:4010/apps/api/booking
TPC_API_KEY=test-key
TPC_API_ID=1
# Which consignment range to draw numbers from: test (TPC's 10 test numbers) or production
TPC_RANGE_KIND=test
TPC_SYSTEM_NAME=Shopify
# Fixed text for content_desc (max 20 chars). Leave empty to use the first item's title.
TPC_CONTENT_DESC=Apparel
TPC_NO_OF_PIECES=1
# Added to the order's product weight to cover the box and packing
PACKAGING_GRAMS=100

# --- Booking rules ---
# Also book cash-on-delivery orders when they are created (TPC's API has no COD amount field)
BOOK_COD_ORDERS=false

# --- Fulfilment on handover ---
TRACKING_COMPANY=The Professional Couriers
# {number} is replaced with the consignment number. Leave empty for no tracking link.
TRACKING_URL_TEMPLATE=
NOTIFY_CUSTOMER_ON_FULFIL=true

# --- Order tags staff use / the app sets ---
TAG_HANDOVER=tpc-handover
TAG_RETRY=tpc-retry
TAG_BOOKED=tpc-booked
TAG_FAILED=tpc-failed
TAG_FULFILLED=tpc-fulfilled
TAG_DRY_RUN=tpc-dry-run

# --- Mock TPC server (npm run mock:tpc) ---
MOCK_TPC_PORT=4010
