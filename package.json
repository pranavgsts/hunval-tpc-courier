{
  "name": "hunval-tpc-courier",
  "version": "0.1.0",
  "private": true,
  "description": "Shopify custom app that books Hunval orders with The Professional Courier (TPC) and fulfils them on handover.",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "mock:tpc": "node scripts/mock-tpc.js",
    "range:add": "node scripts/add-range.js",
    "range:status": "node scripts/range-status.js",
    "shopify:setup": "node scripts/setup-shopify.js",
    "test": "node --test --test-concurrency=1"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3"
  }
}
